{
  "expo": {
    "name": "MCF Citizen",
    "slug": "MCF-CITIZEN",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/MCF_Logo.png",
    "scheme": "mcfcitizen",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/MCF_Logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.MCFCITIZEN"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/MCF_Logo.png",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}